# Copy to .dev.vars (for wrangler) or .env (for astro dev) and fill in.
# All of these are optional: the site builds and runs without them.

# Contact form spam protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form delivery (Resend). Without these, the form shows a friendly
# "use email instead" message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Keystatic in production (GitHub mode). Generated by visiting /keystatic
# locally once and following the GitHub App setup. See README.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
