---
import { ClientRouter } from 'astro:transitions';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { t, other, url, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of this page in the other language. Defaults to the same section. */
  alternate?: string;
  current?: string;
}

const { lang, title, description = t(lang, 'site.description'), current } = Astro.props;
const alt = Astro.props.alternate ?? Astro.url.pathname.replace(/^\/(en|da)(\/|$)/, `/${other(lang)}$2`);
const fullTitle = title ? `${title} – Magnus H. Kaspersen` : 'Magnus H. Kaspersen';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other(lang)} href={new URL(alt, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`Magnus H. Kaspersen (${lang.toUpperCase()})`} href={url(lang, 'rss.xml').slice(0, -1)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#eef0eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101411" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'da' ? 'da_DK' : 'en_GB'} />
    <meta property="og:url" content={canonical} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} alternate={alt} current={current} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  body { min-height: 100dvh; display: flex; flex-direction: column; }
  main { flex: 1; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { position: fixed; left: 12px; top: 12px; z-index: 10; background: var(--paper); padding: 8px 12px; }
</style>
