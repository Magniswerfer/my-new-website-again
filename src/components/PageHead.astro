---
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---

<header class="head">
  <h1>{title}</h1>
  {intro && <p class="lede">{intro}</p>}
</header>

<style>
  .head { display: grid; gap: 0.9rem; padding-block: 1rem calc(var(--space) * 1.25); }
  .lede { color: var(--muted); }
</style>
