---
import { t, url, type Lang } from '~/i18n';
import { getSettings } from '~/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const settings = await getSettings();
const year = new Date().getFullYear();
const rss = url(lang, 'rss.xml').slice(0, -1);
---

<footer class="foot">
  <div class="wrap f-in">
    <span class="engraved">{t(lang, 'footer.follow')}</span>
    <p>
      {settings.email && <>{t(lang, 'footer.write')} <a href={`mailto:${settings.email}`}>{settings.email}</a> {t(lang, 'footer.orForm')} </>}
      <a href={url(lang, 'contact')}>{t(lang, 'footer.form')}</a>.
    </p>
    <p>
      {t(lang, 'footer.follow2')} <a href={rss}>RSS</a>{settings.links.length > 0 && <>, {lang === 'da' ? 'og jeg er også på' : 'and I’m also on'} {settings.links.map((l, i) => <>{i > 0 && (i === settings.links.length - 1 ? (lang === 'da' ? ' og ' : ' and ') : ', ')}<a href={l.url} rel="me">{l.label}</a></>)}</>}.
    </p>

    {settings.buttondownUsername && (
      <form action={`https://buttondown.com/api/emails/embed-subscribe/${settings.buttondownUsername}`} method="post" target="_blank">
        <label for="bd-email">{t(lang, 'footer.newsletter')}</label>
        <div class="field">
          <input id="bd-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          <input type="hidden" name="tag" value={lang} />
          <button type="submit" class="key">{t(lang, 'footer.subscribe')}</button>
        </div>
      </form>
    )}

    <div class="controls">
      <div class="motion" role="group" aria-label={t(lang, 'motion.label')}>
        <span class="engraved">{t(lang, 'motion.label')}</span>
        <button type="button" class="key small" data-motion="on" aria-pressed="true"><span class="led"></span>{t(lang, 'motion.play')}</button>
        <button type="button" class="key small" data-motion="off" aria-pressed="false">{t(lang, 'motion.stop')}</button>
      </div>
      <span class="engraved">© {year} Magnus H. Kaspersen</span>
    </div>
  </div>
</footer>

<script>
  function sync() {
    let on = true;
    try { on = localStorage.getItem('mhk:motion') !== 'off'; } catch {}
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) on = false;
    document.querySelectorAll<HTMLButtonElement>('[data-motion]').forEach((b) =>
      b.setAttribute('aria-pressed', String((b.dataset.motion === 'on') === on)));
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-motion]');
    if (!b) return;
    try { localStorage.setItem('mhk:motion', b.dataset.motion!); } catch {}
    sync();
  });
  document.addEventListener('astro:page-load', sync);
</script>

<style>
  /* Horizontal grooves that fade in from the top. */
  .foot { position: relative; margin-top: var(--block); }
  .foot::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: repeating-linear-gradient(180deg, transparent 0 6px, var(--groove-strong) 6px 7px);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 85%); mask-image: linear-gradient(180deg, transparent, #000 85%);
  }
  .f-in { position: relative; display: grid; gap: 8px; padding-block: 56px calc(64px + env(safe-area-inset-bottom, 0px)); }
  .f-in > .engraved { margin-bottom: 6px; }
  .f-in p { max-width: 40rem; }
  form { display: grid; gap: 8px; max-width: 30rem; margin-top: 18px; }
  label { color: var(--soft); font-size: 0.95rem; }
  .field { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  input[type='email'] {
    flex: 1 1 14rem; min-width: 0; font: inherit; color: var(--ink); background: var(--paper-deep);
    border: 0; border-radius: 999px; padding: 0.6rem 1rem; box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.15);
  }
  input[type='email']:focus { outline: 2px solid var(--accent); }
  .controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; margin-top: 22px; }
  .motion { display: flex; align-items: center; gap: 12px; }
  .motion .engraved { margin-right: 4px; }
</style>
