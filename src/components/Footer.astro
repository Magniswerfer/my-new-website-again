---
import { t, url, type Lang } from '~/i18n';
import { getSettings } from '~/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const settings = await getSettings();
const year = new Date().getFullYear();
const rss = url(lang, 'rss.xml').slice(0, -1);
---

<footer class="wrap row">
  <div class="margin">
    <p class="margin-title">{t(lang, 'footer.follow')}</p>
  </div>
  <div class="column">
    <p>
      {settings.email && <>{t(lang, 'footer.write')} <a href={`mailto:${settings.email}`}>{settings.email}</a> {t(lang, 'footer.orForm')} </>}
      <a href={url(lang, 'contact')}>{t(lang, 'footer.form')}</a>.{' '}
      {t(lang, 'footer.follow2')} <a href={rss}>RSS</a>{settings.links.length > 0 && <>, {lang === 'da' ? 'og jeg er også på' : 'and I’m also on'} {settings.links.map((l, i) => <>{i > 0 && (i === settings.links.length - 1 ? (lang === 'da' ? ' og ' : ' and ') : ', ')}<a href={l.url} rel="me">{l.label}</a></>)}</>}.
    </p>

    {settings.buttondownUsername && (
      <form action={`https://buttondown.com/api/emails/embed-subscribe/${settings.buttondownUsername}`} method="post" target="_blank">
        <label for="bd-email">{t(lang, 'footer.newsletter')}</label>
        <div class="field">
          <input id="bd-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          <input type="hidden" name="tag" value={lang} />
          <button type="submit">{t(lang, 'footer.subscribe')}</button>
        </div>
      </form>
    )}

    <p class="num small">© {year} Magnus H. Kaspersen</p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--block);
    padding-block: 2rem calc(2.5rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--rule);
  }
  .column { display: grid; gap: 1.25rem; }
  .column > p:first-child { max-width: 36rem; }
  form { display: grid; gap: 0.5rem; max-width: 30rem; }
  label { color: var(--muted); font-size: 0.95rem; }
  .field { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  input[type='email'] {
    flex: 1 1 14rem; min-width: 0; font: inherit; color: var(--ink); background: transparent;
    border: 0; border-bottom: 1.5px solid var(--ink); padding: 0.4rem 0;
  }
  input[type='email']:focus { outline: none; border-bottom-color: var(--pine); }
  button {
    font: 600 0.95rem/1 var(--f-text); color: var(--paper); background: var(--ink); border: 0;
    padding: 0.7rem 1.1rem; cursor: pointer;
  }
  button:hover { background: var(--pine); }
  .small { font-size: 0.75rem; }
</style>
