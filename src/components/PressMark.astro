---
/**
 * The press mark: a small leaf sprig that closes a piece, the way a
 * private-press book marks the end of a text. Indigo stem and leaves,
 * one madder berry.
 */
interface Props { class?: string }
const { class: className } = Astro.props;
---

<span class:list={['press-mark', className]} aria-hidden="true">
  <svg viewBox="0 0 44 22" width="66" height="33">
    <path class="stem" d="M3 15.5c7.5-1.2 14.2-4.4 20.6-9.2 4.3-3.2 9.2-4.7 15.6-3.8" />
    <path class="leaf" d="M12.2 13.1c-.6-4.6 2-7.6 6.7-8.1.2 4.3-2.2 7.3-6.7 8.1z" />
    <path class="leaf" d="M19.9 9.4c3.8-2.6 7.7-2.1 10.6 1.3-3.4 2.6-7.4 2.3-10.6-1.3z" />
    <path class="leaf" d="M28.6 4.4c1-3.1 3.6-4.2 6.6-3.2-1 3-3.6 4.1-6.6 3.2z" />
    <circle class="berry" cx="39.6" cy="2.9" r="2.1" />
  </svg>
</span>

<style>
  .press-mark { display: block; color: var(--accent); }
  svg { display: block; overflow: visible; }
  .stem { fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; }
  .leaf { fill: currentColor; opacity: 0.85; }
  .berry { fill: var(--madder); }
</style>
