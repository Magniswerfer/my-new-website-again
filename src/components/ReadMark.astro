---
/**
 * A pencil tick in the margin, shown beside things this visitor has
 * already read (patina: the site wears in with use). Hidden until the
 * read-marks script marks its row with [data-read]. Nothing leaves the
 * visitor's browser.
 */
---

<span class="read-mark" aria-hidden="true">
  <svg viewBox="0 0 18 13" width="18" height="13"><path d="M1.6 7.4c1.4.8 2.6 2.1 3.5 3.9C7.3 6.6 10.6 3 16.4 1.3" /></svg>
</span>

<style>
  .read-mark {
    position: absolute; right: 0.9rem; top: 0.25rem; display: none;
    color: var(--accent); transform: rotate(-4deg);
  }
  :global([data-read]) > :global(.margin) .read-mark,
  :global([data-read]) .read-mark { display: block; }
  svg { display: block; overflow: visible; }
  path { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 52rem) {
    .read-mark { position: static; display: none; order: 99; }
    :global([data-read]) .read-mark { display: inline-block; }
  }
</style>
