---
/**
 * A project as an instrument plate: a nameplate held on by four screws.
 * Point at the plate and the screws turn a quarter, as if you're about to
 * open it up. The title's underline carries the view-transition name, so
 * it becomes the heading rule on the project page.
 */
import { ruleName } from '~/lib/content';

interface Props { id: string; href: string; title: string; year: number; summary?: string; link?: string }
const { id, href, title, year, summary, link } = Astro.props;

const where = link ? (() => {
  try { const u = new URL(link); return (u.host + u.pathname).replace(/\/$/, ''); } catch { return undefined; }
})() : undefined;

// Each screw sits at its own angle, the way real screws end up.
const screws = [['tl', 22], ['tr', -38], ['bl', 64], ['br', 8]] as const;
---

<article class="plate">
  {screws.map(([pos, r]) => <span class:list={['screw', pos]} style={`--r: ${r}deg`} aria-hidden="true"></span>)}
  <div class="head">
    <h3>
      <a class="plate-link" href={href}><span class="t">{title}<span class="ul offprint" aria-hidden="true" transition:name={ruleName('projects', id)}></span></span></a>
    </h3>
    <span class="num">{year}</span>
  </div>
  {summary && <p class="summary">{summary}</p>}
  {where && <p class="num where">{where}</p>}
</article>

<style>
  .plate {
    position: relative; display: grid; gap: 0.6rem; align-content: start;
    padding: 1.5rem 1.75rem 1.4rem;
    background: var(--plate); border: 1px solid var(--rule); border-radius: 3px;
    box-shadow: 0 1px 0 var(--rule), 0 6px 18px -14px var(--hole-shade);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .plate:hover, .plate:focus-within { border-color: var(--accent-ghost); box-shadow: 0 1px 0 var(--rule), 0 10px 24px -14px var(--hole-shade); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  h3 { font-size: var(--t-title); }
  .plate-link { text-decoration: none; }
  /* The whole plate is the link target. */
  .plate-link::after { content: ''; position: absolute; inset: 0; }
  .t { position: relative; display: inline-block; padding-bottom: 0.3rem; }
  .ul { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent); transition: height 0.15s; }
  .plate:hover .ul { height: 4px; }
  .summary { color: var(--muted); max-width: 34em; }
  .where { font-size: 0.75rem; overflow-wrap: anywhere; }

  .screw {
    position: absolute; width: 9px; height: 9px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--knob) 0 30%, var(--hole) 75%);
    box-shadow: inset 0 0 0 1px var(--rule), 0 1px 1px var(--hole-shade);
    transform: rotate(var(--r));
    transition: transform 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .screw::after {
    content: ''; position: absolute; left: 1.5px; right: 1.5px; top: 50%; height: 1.2px; margin-top: -0.6px;
    background: var(--hole-shade); border-radius: 1px;
  }
  .tl { top: 7px; left: 7px; } .tr { top: 7px; right: 7px; }
  .bl { bottom: 7px; left: 7px; } .br { bottom: 7px; right: 7px; }
  .plate:hover .screw, .plate:focus-within .screw { transform: rotate(calc(var(--r) + 90deg)); }
  @media (prefers-reduced-motion: reduce) { .screw { transition: none; } }
</style>
