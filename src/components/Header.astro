---
import { t, url, other, type Lang } from '~/i18n';

interface Props { lang: Lang; alternate: string; current?: string }
const { lang, alternate, current } = Astro.props;

const items = [
  ['about', 'nav.about'],
  ['writing', 'nav.writing'],
  ['projects', 'nav.projects'],
  ['photos', 'nav.photos'],
  ['bookshelf', 'nav.bookshelf'],
  ['now', 'nav.now'],
] as const;
---

<header class="wrap">
  <a class="mark" href={url(lang)} aria-label="Magnus H. Kaspersen, home">Magnus H. Kaspersen<span class="dot" aria-hidden="true"></span></a>
  <nav aria-label="Main">
    <ul>
      {items.map(([slug, key]) => (
        <li><a href={url(lang, slug)} aria-current={current === slug ? 'page' : undefined}>{t(lang, key)}</a></li>
      ))}
      <li class="lang">
        <a href={alternate} hreflang={other(lang)} lang={other(lang)} aria-label={t(lang, 'lang.switchLabel')} data-astro-reload data-lang-switch={other(lang)}>
          {other(lang).toUpperCase()}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Remember an explicit language choice so the root URL respects it next time.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLElement>('[data-lang-switch]');
    if (a) try { localStorage.setItem('lang', a.dataset.langSwitch!); } catch {}
  });
</script>

<style>
  header {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: 0.75rem 2rem; padding-block: clamp(1.25rem, 3vw, 2rem);
  }
  .mark {
    font-family: var(--f-display); font-weight: 800; font-size: 1.3rem; letter-spacing: var(--track);
    text-decoration: none; line-height: 1; white-space: nowrap;
  }
  .mark:hover { color: inherit; }
  .dot {
    display: inline-block; width: 0.36em; height: 0.36em; border-radius: 50%;
    background: var(--pine); margin-left: 0.28em; vertical-align: 0.04em;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  nav a { font-family: var(--f-mono); font-size: var(--step--1); text-decoration: none; }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--pine); text-underline-offset: 0.4em; }
  .lang a { color: var(--muted); }
  .lang a:hover { color: var(--pine); }
</style>
