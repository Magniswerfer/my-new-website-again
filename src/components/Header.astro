---
import { t, url, other, type Lang } from '~/i18n';

interface Props { lang: Lang; alternate: string; current?: string }
const { lang, alternate, current } = Astro.props;

const items = [
  ['blog', 'nav.writing'],
  ['weeks', 'nav.weeks'],
  ['projects', 'nav.projects'],
  ['photos', 'nav.photos'],
  ['rotation', 'nav.bookshelf'],
  ['about', 'nav.about'],
] as const;
---

<header class="wrap row">
  <div class="margin">
    <a class="mark" href={url(lang)}>Magnus H. Kaspersen<span class="dot offprint" aria-hidden="true"></span></a>
  </div>
  <nav class="column" aria-label={lang === 'da' ? 'Hovedmenu' : 'Main'}>
    <ul>
      {items.map(([slug, key]) => (
        <li><a href={url(lang, slug)} aria-current={current === slug ? 'page' : undefined}>{t(lang, key)}</a></li>
      ))}
      <li class="lang">
        <a href={alternate} hreflang={other(lang)} lang={other(lang)} data-astro-reload data-lang-switch={other(lang)}>
          {t(lang, 'lang.switch')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Remember an explicit language choice so the root URL respects it next time.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLElement>('[data-lang-switch]');
    if (a) try { localStorage.setItem('lang', a.dataset.langSwitch!); } catch {}
  });
</script>

<style>
  header { padding-block: clamp(1.25rem, 3vw, 2.25rem); align-items: baseline; }
  .margin { padding-top: 0 !important; }
  .mark {
    font-family: var(--f-display); font-weight: 800; font-size: var(--t-body);
    letter-spacing: var(--track); line-height: 1.15; text-decoration: none; display: inline-block; white-space: nowrap;
  }
  .dot {
    display: inline-block; width: 0.38em; height: 0.38em; border-radius: 50%;
    background: var(--pine); margin-left: 0.3em; vertical-align: 0.05em;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 1.4rem; }
  nav a { text-decoration: none; font-size: 0.97rem; }
  nav a:hover { text-decoration: underline; text-decoration-color: var(--pine); }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--pine); text-decoration-thickness: 2px; text-underline-offset: 0.35em; }
  .lang a { color: var(--muted); }
  @media (max-width: 52rem) {
    header { row-gap: 0.75rem; }
    .mark { font-size: 1.25rem; }
  }
</style>
