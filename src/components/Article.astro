---
/**
 * Post/project layout on the margin/column grid. The margin holds the
 * context (kind, week, date, reading time) and, on essays, the reading
 * line. The title's pine rule is the target of the underline transition.
 */
import ReadingLine from './ReadingLine.astro';

interface Props {
  margin: string[];
  title: string;
  ruleName: string;
  readingLine?: boolean;
}
const { margin, title, ruleName, readingLine = false } = Astro.props;
---

<article class="row article" data-reading={readingLine ? '' : undefined}>
  <div class="margin">
    {margin.map((line, i) => <span class:list={[i === 0 ? 'margin-title' : 'num']}>{line}</span>)}
    {readingLine && <ReadingLine />}
  </div>
  <div class="column">
    <h1>{title}</h1>
    <div class="rule" transition:name={ruleName}></div>
    <div class="prose"><slot /></div>
    <slot name="after" />
  </div>
</article>

<style>
  .article { padding-top: clamp(1rem, 4vw, 3rem); }
  .article > .margin { align-self: stretch; align-content: start; padding-top: 0.55rem; }
  .rule { height: 3px; background: var(--pine); margin: 1.5rem 0 2.25rem; }
</style>
