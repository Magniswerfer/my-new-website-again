---
/**
 * Post/project layout. The heading sits in the contour field; the label
 * column holds the context (kind, week, date, reading time) and, on essays,
 * the reading line.
 */
import ReadingLine from './ReadingLine.astro';
import Icon, { type IconName } from './Icon.astro';
import Avatar2D from './Avatar2D.astro';

interface Props {
  margin: string[];
  title: string;
  icon: IconName;
  readingLine?: boolean;
}
const { margin, title, icon, readingLine = false } = Astro.props;
---

<header class="a-head" data-field>
  <div class="text" data-field-text>
    <span class="engraved kicker"><Icon name={icon} />{margin.map((m) => <span>{m}</span>)}</span>
    <h1>{title}</h1>
  </div>
</header>

<article class="row article" data-reading={readingLine ? '' : undefined}>
  <div class="margin">{readingLine && <ReadingLine />}</div>
  <div class="column">
    <div class="prose"><slot /></div>
    {readingLine && <p class="end" aria-hidden="true"><Avatar2D size={24} asleep /></p>}
    <slot name="after" />
  </div>
</article>

<style>
  .a-head { padding-block: clamp(40px, 6vw, 88px) clamp(40px, 6vw, 72px); }
  .text { display: grid; gap: 18px; max-width: 46rem; }
  .kicker { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
  .kicker .pic { width: 16px; height: 16px; }
  h1 { font-size: clamp(2.4rem, 1.5rem + 3.2vw, 4rem); }
  /* Prose lines up with the heading; the reading line runs in the left gutter. */
  .article { display: block; position: relative; }
  .article > .margin { position: absolute; top: 0; bottom: 0; left: calc(-1 * var(--gutter-l) + 8px); width: 12px; padding: 0; display: block; margin: 0; }
  .article > .column { max-width: 40rem; }
  /* The end mark: the character, eyes closed, signing off. */
  .end { margin: 2.4rem 0 0; line-height: 0; }
</style>
