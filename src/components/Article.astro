---
/**
 * Shared layout for a post or project page: back link, meta line, title,
 * the pine heading rule (target of the underline → heading transition),
 * then the body. Essays also get the reading line.
 */
import ReadingLine from './ReadingLine.astro';

interface Props {
  backHref: string;
  backLabel: string;
  meta: string;
  title: string;
  ruleName: string;
  readingLine?: boolean;
}
const { backHref, backLabel, meta, title, ruleName, readingLine = false } = Astro.props;
---

<article class:list={['article', { reading: readingLine }]} data-reading={readingLine ? '' : undefined}>
  {readingLine && <ReadingLine />}
  <div class="col">
    <a class="back mono" href={backHref}>← {backLabel}</a>
    <p class="mono meta">{meta}</p>
    <h1>{title}</h1>
    <div class="rule" transition:name={ruleName}></div>
    <div class="prose"><slot /></div>
    <slot name="after" />
  </div>
</article>

<style>
  .article { display: grid; grid-template-columns: minmax(0, 1fr); }
  .article.reading { grid-template-columns: 2.25rem minmax(0, 1fr); column-gap: clamp(0.25rem, 2vw, 1.5rem); margin-left: -0.5rem; }
  .col { display: grid; gap: 0; min-width: 0; max-width: 46rem; }
  .back { text-decoration: none; justify-self: start; }
  .back:hover { color: var(--pine); }
  .meta { margin-top: 1.75rem; }
  h1 { margin-top: 0.5rem; font-size: var(--step-3); }
  .rule { height: 3px; background: var(--pine); margin: 1.4rem 0 2rem; }
  @media (max-width: 30rem) { .article.reading { grid-template-columns: 1rem minmax(0, 1fr); margin-left: -0.25rem; } }
</style>
