---
/**
 * The character as a flat vector drawing, traced from a front render of the 3D model
 * (design/avatar/build.py): next to the name in the header, and the favicon. Strokes are
 * a touch thicker than the model so the face still reads at 24 px.
 */
interface Props { size?: number; class?: string; asleep?: boolean; label?: string }
const { size = 40, class: cls, asleep = false, label } = Astro.props;
const id = 'av' + Math.random().toString(36).slice(2, 8);
---

<svg class:list={['avatar-2d', cls]} width={size} height={(size * 137) / 122} viewBox="-1 -1 122 137"
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <defs>
    <radialGradient id={`${id}-b`} cx="0.36" cy="0.26" r="0.85">
      <stop offset="0" stop-color="#F7F3EE" />
      <stop offset="0.6" stop-color="#E6DFD7" />
      <stop offset="1" stop-color="#C9C0B6" />
    </radialGradient>
    <radialGradient id={`${id}-l`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#7EE07A" />
      <stop offset="1" stop-color="#2FB352" />
    </radialGradient>
  </defs>
  <ellipse cx="60" cy="134.3" rx="40" ry="3.2" fill="#000" opacity="0.1" />
  <!-- legs: straight stubs, soft flat soles -->
  <path d="M25.3 104 H56.6 V127.8 Q56.6 134.7 49.7 134.7 H32.2 Q25.3 134.7 25.3 127.8 Z" fill={`url(#${id}-b)`} />
  <path d="M63.4 104 H94.7 V127.8 Q94.7 134.7 87.8 134.7 H70.3 Q63.4 134.7 63.4 127.8 Z" fill={`url(#${id}-b)`} />
  <!-- arms: plump mittens, tilted out a little -->
  <ellipse cx="12.6" cy="80.8" rx="11.6" ry="19" transform="rotate(17 12.6 80.8)" fill={`url(#${id}-b)`} />
  <ellipse cx="107.4" cy="80.8" rx="11.6" ry="19" transform="rotate(-17 107.4 80.8)" fill={`url(#${id}-b)`} />
  <!-- shell: traced from the 3D model, front view -->
  <path d="M60.0 0.0 L71.8 0.9 L77.4 1.9 L81.2 2.8 L84.1 3.7 L86.3 4.6 L88.1 5.5 L89.5 6.5 L90.8 7.4 L91.9 8.3 L92.8 9.2 L93.7 10.2 L94.5 11.1 L95.2 12.0 L97.8 16.0 L99.8 20.0 L101.3 24.0 L102.5 28.0 L103.4 32.0 L103.9 36.0 L104.3 40.0 L104.8 44.0 L105.1 48.0 L105.2 52.0 L105.2 56.0 L105.2 60.0 L105.2 64.0 L105.2 68.0 L105.2 72.0 L105.2 76.0 L105.2 80.0 L105.2 84.0 L105.2 88.0 L104.7 92.0 L104.0 96.0 L103.9 97.0 L103.9 98.0 L103.7 99.0 L103.5 100.0 L103.2 101.0 L102.6 102.0 L102.0 103.0 L101.2 104.0 L100.2 105.1 L98.8 106.1 L97.0 107.1 L94.4 108.1 L90.8 109.1 L86.3 110.1 L60.0 111.1 L60.0 111.1 L33.7 110.1 L29.2 109.1 L25.6 108.1 L23.0 107.1 L21.2 106.1 L19.8 105.1 L18.8 104.0 L18.0 103.0 L17.4 102.0 L16.8 101.0 L16.5 100.0 L16.3 99.0 L16.1 98.0 L16.1 97.0 L16.0 96.0 L15.3 92.0 L14.8 88.0 L14.8 84.0 L14.8 80.0 L14.8 76.0 L14.8 72.0 L14.8 68.0 L14.8 64.0 L14.8 60.0 L14.8 56.0 L14.8 52.0 L14.9 48.0 L15.2 44.0 L15.7 40.0 L16.1 36.0 L16.6 32.0 L17.5 28.0 L18.7 24.0 L20.2 20.0 L22.2 16.0 L24.8 12.0 L25.5 11.1 L26.3 10.2 L27.2 9.2 L28.1 8.3 L29.2 7.4 L30.5 6.5 L31.9 5.5 L33.7 4.6 L35.9 3.7 L38.8 2.8 L42.6 1.9 L48.2 0.9 L60.0 0.0Z" fill={`url(#${id}-b)`} />
  <!-- grooves between the three ribs -->
  <g fill="none" stroke="#000" stroke-opacity="0.16" stroke-width="1.3" stroke-linecap="round">
    <path d="M15 71.3 Q60 72.6 105 71.3" /><path d="M15 79.3 Q60 80.6 105 79.3" />
    <path d="M15 87.3 Q60 88.6 105 87.3" /><path d="M15.4 95 Q60 96.3 104.6 95" />
  </g>
  <!-- face: pill eyes, a smile; closed eyes are bars as thick as the mouth -->
  {asleep ? (
    <g fill="none" stroke="#16171A" stroke-width="2.6" stroke-linecap="round">
      <path d="M41 34.6 Q44.3 37.8 47.6 34.6" /><path d="M72.4 34.6 Q75.7 37.8 79 34.6" />
    </g>
  ) : (
    <g fill="#16171A">
      <rect x="40.9" y="27.1" width="6.8" height="11.4" rx="3.4" />
      <rect x="72.3" y="27.1" width="6.8" height="11.4" rx="3.4" />
      <rect x="42.1" y="28.6" width="1.9" height="3.2" rx="0.95" fill="#fff" opacity="0.6" />
      <rect x="73.5" y="28.6" width="1.9" height="3.2" rx="0.95" fill="#fff" opacity="0.6" />
    </g>
  )}
  <path d="M54.6 40 Q60 46.2 65.4 40" fill="none" stroke="#16171A" stroke-width="2.6" stroke-linecap="round" />
  <!-- LED in its housing, centred; the button to its right -->
  <circle cx="59.6" cy="58.2" r="4.2" fill="#8F8A84" opacity="0.55" />
  {asleep ? <circle cx="59.6" cy="58.2" r="3.1" fill="#A3A79F" /> : (
    <>
      <circle cx="59.6" cy="58.2" r="6.4" fill="#2FB352" opacity="0.2" />
      <circle cx="59.6" cy="58.2" r="3.1" fill={`url(#${id}-l)`} />
    </>
  )}
  <rect x="67.4" y="54.4" width="18.8" height="7.6" rx="3.8" fill="#F3F0EB" stroke="#000" stroke-opacity="0.3" stroke-width="0.9" />
</svg>
