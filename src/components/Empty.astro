---
/** Shown where a list has nothing in it yet: the character lounges until something arrives. */
import Avatar, { type Pose } from './Avatar.astro';
import SceneAvatar from './SceneAvatar.astro';
import { sceneFor } from '~/lib/scenes';
interface Props { text: string; plain?: boolean; pose?: Pose }
const { text, plain = false, pose = 'beanbag' } = Astro.props;
const scene = sceneFor(pose);
---

{plain ? <p class="empty">{text}</p> : (
  <div class="row">
    <div class="margin"></div>
    <div class="column nap">
      {scene ? <SceneAvatar class="nap-avatar" scene={scene.scene} ratio={scene.ratio} />
        : <Avatar class="nap-avatar" pose={pose} label="" sizes="170px" />}
      <p class="empty">{text}</p>
    </div>
  </div>
)}

<style>
  .empty { color: var(--soft); max-width: 40rem; }
  .nap { display: flex; align-items: center; gap: 20px; }
  .nap :global(.nap-avatar) { flex: none; width: 170px; margin: -36px -20px -36px -34px; }
  @media (max-width: 560px) { .nap { margin-top: 40px; } .nap :global(.nap-avatar) { width: 140px; margin: -24px -12px -30px -22px; } }
</style>
