---
/**
 * "Open the case": shows how the page is built, the way a repairable
 * object shows its screws. Toggled by any [data-case-toggle] button or the
 * G key; Esc closes it. Outlines the margin and column, draws the baseline,
 * labels headings with their level, and shows a card with the grid measured
 * live from this page and the palette.
 */
import { t, type Lang } from '~/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<aside class="case-card" aria-labelledby="case-title" hidden data-case-card>
  <h2 id="case-title">{t(lang, 'case.title')}</h2>
  <dl>
    <dt>{t(lang, 'case.grid')}</dt>
    <dd data-case-grid>…</dd>
    <dt>{t(lang, 'case.type')}</dt>
    <dd>Schibsted Grotesk 800, 600<br />IBM Plex Sans 400<br />IBM Plex Mono</dd>
    <dt>{t(lang, 'case.base')}</dt>
    <dd>17px / 1.6</dd>
    <dt>{t(lang, 'case.colour')}</dt>
    <dd class="swatches">
      <span><i style="background: var(--paper)"></i>{t(lang, 'case.linen')}</span>
      <span><i style="background: var(--ink)"></i>{t(lang, 'case.ink')}</span>
      <span><i style="background: var(--accent)"></i>{t(lang, 'case.indigo')}</span>
      <span><i style="background: var(--madder)"></i>{t(lang, 'case.madder')}</span>
    </dd>
  </dl>
  <button type="button" data-case-toggle>{t(lang, 'case.close')}</button>
</aside>

<script>
  const px = (n: number) => `${Math.round(n)}px`;

  function measure() {
    const row = document.querySelector('main .row') ?? document.querySelector('.row');
    const margin = row?.querySelector<HTMLElement>(':scope > .margin');
    const column = row?.querySelector<HTMLElement>(':scope > .column');
    const out = document.querySelector<HTMLElement>('[data-case-grid]');
    if (!out || !column) return;
    const gap = parseFloat(getComputedStyle(row!).columnGap) || 0;
    const m = margin?.getBoundingClientRect().width ?? 0;
    out.textContent = m > 0
      ? `${px(m)} + ${px(gap)} + ${px(column.getBoundingClientRect().width)}`
      : px(column.getBoundingClientRect().width);
  }

  function setCase(open: boolean) {
    const root = document.documentElement;
    const card = document.querySelector<HTMLElement>('[data-case-card]');
    if (open) { root.dataset.case = 'open'; measure(); } else delete root.dataset.case;
    if (card) card.hidden = !open;
    document.querySelectorAll('[data-case-toggle]').forEach((b) => b.setAttribute('aria-expanded', String(open)));
  }
  const isOpen = () => document.documentElement.dataset.case === 'open';

  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-case-toggle]')) setCase(!isOpen());
  });
  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    if (el.closest('input, textarea, select, [contenteditable]') || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'g' || e.key === 'G') setCase(!isOpen());
    if (e.key === 'Escape' && isOpen()) setCase(false);
  });
  window.addEventListener('resize', () => { if (isOpen()) measure(); });
  // Keep it open across page transitions, re-measuring the new page.
  document.addEventListener('astro:after-swap', () => { if (isOpen()) setCase(true); });
</script>

<style>
  .case-card {
    position: fixed; z-index: 90;
    left: max(12px, env(safe-area-inset-left, 0px)); bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    width: min(18rem, calc(100vw - 24px)); max-height: calc(100dvh - 24px); overflow: auto;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--accent); border-radius: 6px;
    box-shadow: 3px 3px 0 var(--accent-ghost);
    padding: 1rem 1.1rem; font-size: 0.8125rem; line-height: 1.45;
    display: grid; gap: 0.75rem;
  }
  .case-card[hidden] { display: none; }
  h2 { font-size: 1rem; font-weight: 600; }
  dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 0.9rem; }
  dt { color: var(--muted); }
  dd { margin: 0; font-family: var(--f-num); font-size: 0.75rem; }
  .swatches { display: grid; gap: 0.25rem; font-family: var(--f-text); font-size: 0.8125rem; }
  .swatches span { display: flex; align-items: center; gap: 0.45rem; }
  .swatches i { width: 0.85rem; height: 0.85rem; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--rule); }
  button {
    justify-self: start; font: 500 0.8125rem/1 var(--f-text); color: var(--ink); background: var(--hole);
    border: 0; border-radius: 6px; padding: 0.55rem 0.8rem; cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--rule), 0 2px 0 var(--hole-shade);
  }
  button:active { box-shadow: inset 0 0 0 1px var(--rule), 0 1px 0 var(--hole-shade); }

  /* The opened case: construction lines over the real page. */
  :global(html[data-case='open']) :global(.row > .margin),
  :global(html[data-case='open']) :global(.row > .column) {
    outline: 1px dashed var(--accent); outline-offset: -1px;
    background-color: color-mix(in srgb, var(--accent) 4%, transparent);
  }
  :global(html[data-case='open']) :global(main) {
    background-image: repeating-linear-gradient(to bottom, transparent 0 calc(1.7rem - 1px), color-mix(in srgb, var(--accent) 22%, transparent) calc(1.7rem - 1px) 1.7rem);
  }
  :global(html[data-case='open']) :global(:is(h1, h2, h3, .this-week)) { position: relative; }
  :global(html[data-case='open']) :global(:is(h1, .this-week))::after,
  :global(html[data-case='open']) :global(main :is(h2, h3))::after,
  :global(html[data-case='open']) :global(.entries .column > a)::before {
    position: absolute; left: 0; top: -1.15rem;
    font: 400 0.6875rem/1 var(--f-num); letter-spacing: 0; color: var(--accent); white-space: nowrap;
  }
  :global(html[data-case='open']) :global(:is(h1, .this-week))::after { content: '1  Schibsted Grotesk 800'; }
  :global(html[data-case='open']) :global(main :is(h2, h3))::after { content: '2  Schibsted Grotesk 600'; }
  :global(html[data-case='open']) :global(.entries .column > a)::before { content: '2  Schibsted Grotesk 600'; }
</style>
