---
/**
 * A list of posts or projects. Each title's underline carries a
 * view-transition-name that matches the heading rule on the target page,
 * so clicking it morphs the underline into that rule.
 * `plain` renders just the items (for use inside a section's content column);
 * otherwise each item sits on the label/content grid with its week or year.
 */
import { isoDate, isoWeek, weekLabel, type Lang } from '~/i18n';
import { ruleName } from '~/lib/content';
import ReadMark from './ReadMark.astro';

interface Item { id: string; href: string; title: string; date?: Date; year?: number; summary?: string; where?: string }
interface Props { items: Item[]; collection: 'posts' | 'projects'; lang: Lang; showSummary?: boolean; showYear?: boolean; plain?: boolean }
const { items, collection, lang, showSummary = true, showYear = false, plain = false } = Astro.props;

let lastYear: number | undefined;
const rows = items.map((item) => {
  const year = item.date ? isoWeek(item.date).year : item.year;
  const yearChanged = showYear && year !== lastYear;
  lastYear = year;
  return { ...item, yearLabel: yearChanged ? year : undefined };
});
---

<ol class:list={['entries', { plain }]}>
  {rows.map((item) => (
    <li class:list={[{ row: !plain }]} data-href={collection === 'posts' ? item.href : undefined}>
      {!plain && (
        <div class="margin">
          {collection === 'posts' && <ReadMark />}
          {item.yearLabel && <span class="margin-title">{item.yearLabel}</span>}
          {item.date
            ? <time class="engraved" datetime={isoDate(item.date)}>{weekLabel(lang, item.date)}</time>
            : !showYear && item.year && <span class="engraved">{item.year}</span>}
        </div>
      )}
      <div class="column">
        <a class="title" href={item.href}>
          <span class="t">{item.title}<span class="ul" aria-hidden="true" transition:name={ruleName(collection, item.id)}></span></span>
        </a>
        {showSummary && item.summary && <p class="summary">{item.summary}</p>}
        {plain && item.date && <time class="engraved" datetime={isoDate(item.date)}>{weekLabel(lang, item.date)}</time>}
        {item.where && <p class="engraved where">{item.where}</p>}
      </div>
    </li>
  ))}
</ol>

<script>
  import { tickRead } from '~/lib/readmarks';
  document.addEventListener('astro:page-load', () => tickRead());
</script>

<style>
  .entries { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .column { display: grid; gap: 4px; justify-items: start; }
  .title { text-decoration: none; font-size: var(--t-title); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .t { position: relative; display: inline-block; padding-bottom: 3px; }
  /* The underline grows in on hover, in the section's dye. */
  .ul { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.25s var(--ease); }
  .title:hover .ul, .title:focus-visible .ul { transform: scaleX(1); }
  .summary { color: var(--soft); max-width: 40rem; }
  .where { margin-top: 4px; overflow-wrap: anywhere; }
  .margin .engraved { padding-top: 6px; }
</style>
