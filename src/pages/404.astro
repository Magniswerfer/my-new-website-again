---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import { t, url } from '~/i18n';
---

<Base lang="en" title="Not found" alternate="/da/">
  <PageHead title={t('en', 'notfound.title')} intro={t('en', 'notfound.body')} />
  <div class="row">
    <div class="margin"></div>
    <p class="column">
      Go to the <a href={url('en')}>homepage</a>, the <a href={url('en', 'writing')}>writing archive</a>, or <a href={url('da')} lang="da">den danske forside</a>.
    </p>
  </div>
</Base>
