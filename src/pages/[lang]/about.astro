---
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import { t, langPaths, type Lang } from '~/i18n';
import { getPage } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const page = await getPage('about', lang);
const { Content } = page ? await render(page) : { Content: null };
---

<Base lang={lang} title={page?.data.title ?? t(lang, 'nav.about')} current="about">
  <PageHead title={page?.data.title ?? t(lang, 'nav.about')} />
  <div class="prose">{Content && <Content />}</div>
</Base>
