---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import Empty from '~/components/Empty.astro';
import { t, langPaths, formatDate, type Lang } from '~/i18n';
import { getBooks } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const books = await getBooks();

const groups = [
  ['current', 'books.current'],
  ['next', 'books.next'],
  ['finished', 'books.finished'],
] as const;
---

<Base lang={lang} title={t(lang, 'books.title')} current="bookshelf">
  <PageHead title={t(lang, 'books.title')} intro={t(lang, 'books.intro')} />
  {books.length === 0 && <Empty text={t(lang, 'empty.books')} />}
  <div class="groups">
    {groups.map(([status, key]) => {
      const items = books.filter((b) => b.data.status === status);
      return items.length > 0 && (
        <section class="row" aria-labelledby={`g-${status}`}>
          <div class="margin"><h2 id={`g-${status}`} class="margin-title">{t(lang, key)}</h2></div>
          <ul class="column">
            {items.map((b) => {
              const note = lang === 'da' ? b.data.noteDa : b.data.noteEn;
              return (
                <li>
                  <h3>{b.data.title}</h3>
                  <p class="by muted">
                    {b.data.creator}
                    {status === 'finished' && b.data.date && <>, {lang === 'da' ? 'læst' : 'finished'} {formatDate(lang, b.data.date, 'short')}</>}
                  </p>
                  {note && <p class="note">{note}</p>}
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</Base>

<style>
  .groups { display: grid; gap: var(--block); }
  .margin h2 { font-size: 0.9375rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  .by { margin-top: 0.2rem; }
  .note { margin-top: 0.6rem; max-width: 34rem; }
</style>
