---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import { t, langPaths, formatDate, type Lang } from '~/i18n';
import { getBooks } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const books = await getBooks();

const groups = [
  ['current', 'books.current'],
  ['next', 'books.next'],
  ['finished', 'books.finished'],
] as const;
---

<Base lang={lang} title={t(lang, 'books.title')} current="bookshelf">
  <PageHead title={t(lang, 'books.title')} intro={t(lang, 'books.intro')} />
  <div class="groups">
    {groups.map(([status, key]) => {
      const items = books.filter((b) => b.data.status === status);
      return items.length > 0 && (
        <section aria-labelledby={`g-${status}`}>
          <h2 id={`g-${status}`} class="label">{t(lang, key)}</h2>
          <ul>
            {items.map((b) => {
              const note = lang === 'da' ? b.data.noteDa : b.data.noteEn;
              return (
                <li>
                  <div class="title">
                    <h3>{b.data.title}</h3>
                    <span class="mono">{[b.data.creator, b.data.date && status === 'finished' ? formatDate(lang, b.data.date, 'short') : null].filter(Boolean).join(' · ')}</span>
                  </div>
                  {note && <p>{note}</p>}
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</Base>

<style>
  .groups { display: grid; gap: calc(var(--space) * 1.5); max-width: 52rem; }
  ul { list-style: none; margin: 0.6rem 0 0; padding: 0; }
  li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 0.5rem 2rem; padding-block: 1rem; border-top: 1px solid var(--rule); }
  @media (max-width: 40rem) { li { grid-template-columns: minmax(0, 1fr); } }
  .title { display: grid; gap: 0.2rem; }
  h3 { font-size: var(--step-1); }
  li p { color: var(--muted); font-size: 0.95rem; }
</style>
