---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import EntryList from '~/components/EntryList.astro';
import Empty from '~/components/Empty.astro';
import { t, url, langPaths, type Lang } from '~/i18n';
import { getPosts } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const posts = await getPosts(lang);
---

<Base lang={lang} title={t(lang, 'writing.title')} current="blog">
  <PageHead icon="blog" title={t(lang, 'writing.title')} intro={t(lang, 'writing.intro')} pose="laptop" poseLabel={lang === 'da' ? 'Min robotfigur sidder med en bærbar' : 'My robot character sitting with a laptop'} />
  {posts.length === 0 ? <Empty text={t(lang, 'empty.writing')} /> : (
    <EntryList
      lang={lang}
      collection="posts"
      showSummary
      showYear
      items={posts.map((p) => ({ id: p.id, href: url(lang, 'blog', p.id), title: p.data.title, date: p.data.date, summary: p.data.summary }))}
    />
  )}
</Base>
