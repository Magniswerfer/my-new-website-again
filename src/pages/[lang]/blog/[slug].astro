---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Article from '~/components/Article.astro';
import { t, url, formatDate, weekLabel, type Lang } from '~/i18n';
import { getTranslation, ruleName, readingMinutes } from '~/lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { lang: post.data.lang, slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const lang = post.data.lang as Lang;
const { Content } = await render(post);
const translation = await getTranslation('posts', post);
const isEssay = post.data.kind === 'essay';
const margin = [
  t(lang, isEssay ? 'post.essay' : 'post.note'),
  weekLabel(lang, post.data.date),
  formatDate(lang, post.data.date),
  ...(isEssay ? [`${readingMinutes(post.body)} ${t(lang, 'post.min')}`] : []),
];
const alternate = translation ? url(translation.data.lang, 'blog', translation.id) : undefined;
---

<Base lang={lang} title={post.data.title} description={post.data.summary} alternate={alternate} current="blog">
  <Article margin={margin} title={post.data.title} ruleName={ruleName('posts', post.id)} readingLine={isEssay}>
    <Content />
    <p slot="after" class="translation">
      {translation
        ? <a href={alternate} hreflang={translation.data.lang} data-astro-reload>{t(lang, 'post.alsoIn')}: {translation.data.title}</a>
        : <span class="muted">{t(lang, 'post.onlyIn')}</span>}
    </p>
  </Article>
</Base>

<style>
  .translation { margin-top: var(--block); font-size: 0.95rem; }
</style>
