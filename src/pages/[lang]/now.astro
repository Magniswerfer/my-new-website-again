---
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import { t, url, langPaths, formatDate, type Lang } from '~/i18n';
import { getPage, getSettings } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const page = await getPage('now', lang);
const { Content } = page ? await render(page) : { Content: null };
const settings = await getSettings();
---

<Base lang={lang} title={page?.data.title ?? t(lang, 'nav.now')} current="now">
  <PageHead title={page?.data.title ?? t(lang, 'nav.now')} />
  <div class="layout">
    <div class="stack-sm">
      {page?.data.updated && <p class="mono">{t(lang, 'now.updated')} {formatDate(lang, page.data.updated)}</p>}
      <div class="prose">{Content && <Content />}</div>
    </div>
    <aside>
      <h2 class="label">{t(lang, 'now.elsewhere')}</h2>
      <ul>
        {settings.links.map((l) => <li><a href={l.url} rel="me">{l.label}</a></li>)}
        {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
        <li><a href={url(lang, 'contact')}>{t(lang, 'nav.contact')}</a></li>
      </ul>
    </aside>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: calc(var(--space) * 1.5); align-items: start; }
  @media (max-width: 52rem) { .layout { grid-template-columns: minmax(0, 1fr); } }
  .stack-sm { display: grid; gap: 1.25rem; min-width: 0; }
  aside ul { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.4rem; }
  aside a { font-family: var(--f-mono); font-size: var(--step--1); overflow-wrap: anywhere; }
</style>
