---
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import { t, url, langPaths, formatDate, weekLabel, type Lang } from '~/i18n';
import { getPage, getSettings } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const page = await getPage('now', lang);
const { Content } = page ? await render(page) : { Content: null };
const settings = await getSettings();
const updated = page?.data.updated;
---

<Base lang={lang} title={page?.data.title ?? t(lang, 'nav.now')} current="now">
  <PageHead title={page?.data.title ?? t(lang, 'nav.now')} intro={page?.data.thisWeek}>
    {updated && (
      <Fragment slot="margin">
        <span class="margin-title">{weekLabel(lang, updated)}</span>
        <time class="num" datetime={updated.toISOString()}>{formatDate(lang, updated)}</time>
      </Fragment>
    )}
  </PageHead>

  <div class="row">
    <div class="margin"></div>
    <div class="column prose">{Content && <Content />}</div>
  </div>

  <div class="row section">
    <div class="margin"><span class="margin-title">{t(lang, 'now.elsewhere')}</span></div>
    <ul class="column links">
      {settings.links.map((l) => <li><a href={l.url} rel="me">{l.label}</a></li>)}
      {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
      <li><a href={url(lang, 'contact')}>{t(lang, 'nav.contact')}</a></li>
    </ul>
  </div>
</Base>

<style>
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .links a { overflow-wrap: anywhere; }
</style>
