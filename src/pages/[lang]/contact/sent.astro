---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import { t, url, langPaths, type Lang } from '~/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={t(lang, 'contact.sentTitle')}>
  <PageHead title={t(lang, 'contact.sentTitle')} intro={t(lang, 'contact.sentBody')} />
  <div class="row"><div class="margin"></div><p class="column"><a href={url(lang)}>{t(lang, 'contact.back')}</a></p></div>
</Base>
