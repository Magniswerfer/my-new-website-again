---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import WeeksGrid from '~/components/WeeksGrid.astro';
import { t, langPaths, isoWeek, weekLabel, weekRange, isoDate, type Lang } from '~/i18n';
import { getWeeks, weekText, weekAnchor } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const weeks = await getWeeks();

let lastYear: number | undefined;
const rows = weeks.map((w) => {
  const { year } = isoWeek(w.data.date);
  const showYear = year !== lastYear;
  lastYear = year;
  return { entry: w, year, showYear };
});
---

<Base lang={lang} title={t(lang, 'weeks.title')} current="weeks">
  <PageHead title={t(lang, 'weeks.title')} intro={t(lang, 'weeks.intro')}>
    <WeeksGrid slot="margin" lang={lang} />
  </PageHead>

  <ol class="log">
    {rows.map(({ entry, year, showYear }) => (
      <li class="row" id={weekAnchor(entry.data.date)}>
        <div class="margin">
          {showYear && <span class="year num">{year}</span>}
          <span class="label">{weekLabel(lang, entry.data.date)}</span>
          <time class="num" datetime={isoDate(entry.data.date)}>{weekRange(lang, entry.data.date)}</time>
        </div>
        <p class="column text" lang={lang === 'da' && !entry.data.textDa ? 'en' : undefined}>{weekText(entry, lang)}</p>
      </li>
    ))}
  </ol>
</Base>

<style>
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.25rem; }
  li { scroll-margin-top: 2rem; }
  .year { margin-bottom: 0.5rem; }
  /* Older weeks read as plain text; only the newest week is set in the
     display face, so the page has one loud moment. */
  .text { font-size: 1.25rem; line-height: 1.5; max-width: 34em; text-wrap: pretty; }
  .label { font-weight: 500; }
  li:first-child .text {
    font-family: var(--f-display); font-weight: 700; letter-spacing: var(--track);
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.4rem); line-height: 1.15; max-width: 22em;
  }
  li:first-child .label { font-family: var(--f-display); font-weight: 700; letter-spacing: var(--track); }
  li:first-child { margin-bottom: 1rem; }
  li:target .text { text-decoration: underline; text-decoration-color: var(--pine); text-decoration-thickness: 3px; text-underline-offset: 0.2em; }
</style>
