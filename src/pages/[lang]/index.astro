---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EntryList from '~/components/EntryList.astro';
import Empty from '~/components/Empty.astro';
import Icon from '~/components/Icon.astro';
import HeroAvatar from '~/components/HeroAvatar.astro';
import { t, url, langPaths, isoWeek, type Lang } from '~/i18n';
import { getPosts, getProjects, getPhotos, getBooks, getWeeks, weekText, linkLabel } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;

const posts = (await getPosts(lang)).slice(0, 4);
const allProjects = await getProjects(lang);
const projects = (allProjects.some((p) => p.data.featured) ? allProjects.filter((p) => p.data.featured) : allProjects).slice(0, 4);
const photos = (await getPhotos()).slice(0, 3);
const reading = (await getBooks()).filter((b) => b.data.status === 'current').slice(0, 3);
const latest = (await getWeeks())[0];
const { week, year } = isoWeek(latest?.data.date ?? new Date());

// With a week entry, that sentence is the headline and the intro follows.
// Without one, the intro's first sentence is the headline and the rest follows.
const intro = t(lang, 'home.intro');
const split = intro.match(/^(.+?[!.?])\s+(.+)$/);
const headline = latest ? weekText(latest, lang) : split ? split[1] : intro;
const lede = latest ? intro : split ? split[2] : undefined;
---

<Base lang={lang} field="home">
  <section class="hero" aria-labelledby="hello" data-field>
    <HeroAvatar class="hero-avatar" label={lang === 'da' ? 'Min lille robotfigur, der vinker' : 'My little robot character, waving'} />
    <div class="hero-in" data-field-text>
      <span class="engraved">{t(lang, 'home.week')} {week} &nbsp;{year}</span>
      <h1 id="hello" class:list={{ long: !!latest }}>{headline}</h1>
      {lede && <p class="lede">{lede}{latest && <> <a href={url(lang, 'weeks')}>{t(lang, 'home.earlier')}</a>.</>}</p>}
    </div>
  </section>

  <section class="row sec" data-thread="projects" aria-labelledby="h-projects">
    <div class="margin"><a id="h-projects" class="margin-title" href={url(lang, 'projects')}><Icon name="projects" />{t(lang, 'home.projects')}</a></div>
    <div class="column">
      {projects.length === 0 ? <Empty plain text={t(lang, 'empty.projects')} /> : (
        <EntryList plain lang={lang} collection="projects"
          items={projects.map((p) => ({ id: p.id, href: url(lang, 'projects', p.id), title: p.data.title, summary: p.data.summary, where: linkLabel(p.data.link) }))} />
      )}
    </div>
  </section>

  <section class="row sec" data-thread="blog" aria-labelledby="h-blog">
    <div class="margin"><a id="h-blog" class="margin-title" href={url(lang, 'blog')}><Icon name="blog" />{t(lang, 'home.latest')}</a></div>
    <div class="column">
      {posts.length === 0 ? <Empty plain text={t(lang, 'empty.writing')} /> : (
        <EntryList plain lang={lang} collection="posts"
          items={posts.map((p) => ({ id: p.id, href: url(lang, 'blog', p.id), title: p.data.title, date: p.data.date, summary: p.data.summary }))} />
      )}
    </div>
  </section>

  <section class="row sec" data-thread="photos" aria-labelledby="h-photos">
    <div class="margin"><a id="h-photos" class="margin-title" href={url(lang, 'photos')}><Icon name="photos" />{t(lang, 'home.photos')}</a></div>
    <div class="column">
      {photos.length === 0 ? <Empty plain text={t(lang, 'empty.photos')} /> : (
        <div class="strip">
          {photos.map((p) => (
            <a href={url(lang, 'photos') + '#' + p.id}>
              <Image src={p.data.image} alt={(lang === 'da' ? p.data.captionDa : p.data.captionEn) ?? p.data.title} widths={[360, 720]} sizes="(max-width: 52rem) 100vw, 14rem" />
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  {reading.length > 0 && (
    <section class="row sec" data-thread="rotation" aria-labelledby="h-rotation">
      <div class="margin"><a id="h-rotation" class="margin-title" href={url(lang, 'rotation')}><Icon name="rotation" />{t(lang, 'home.reading')}</a></div>
      <ul class="column reading">
        {reading.map((b) => <li><cite>{b.data.title}</cite> <span class="muted">{lang === 'da' ? 'af' : 'by'} {b.data.creator}</span></li>)}
      </ul>
    </section>
  )}
</Base>

<style>
  .hero { position: relative; }
  .hero :global(.hero-avatar) {
    position: absolute; z-index: 3; right: clamp(-40px, 2vw, 60px); bottom: clamp(-60px, -3vw, -20px);
    width: clamp(280px, 32vw, 440px);
  }
  @media (max-width: 760px) {
    .hero :global(.hero-avatar) { right: -10px; bottom: -32px; width: 170px; }
  }
  .hero-in {
    display: grid; gap: 20px; max-width: 34rem;
    padding-block: clamp(56px, 8vw, 112px) clamp(110px, 15vw, 210px);
  }
  h1.long { font-size: clamp(2.2rem, 1.3rem + 3vw, 3.6rem); line-height: 1.04; max-width: 18ch; }
  .lede { font-size: var(--t-lead); line-height: 1.4; max-width: 26ch; }
  @media (max-width: 760px) { .hero-in { padding-block: 40px 200px; } }

  .sec { padding-block: 52px; }
  .sec .margin-title .pic { width: 20px; height: 20px; }
  .reading { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  cite { font-style: italic; }
  .strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
  .strip img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; border-radius: 6px; }
  @media (max-width: 40rem) { .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
