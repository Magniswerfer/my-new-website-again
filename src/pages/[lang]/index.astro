---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EntryList from '~/components/EntryList.astro';
import WeeksGrid from '~/components/WeeksGrid.astro';
import { t, url, langPaths, isoWeek, type Lang } from '~/i18n';
import { getPosts, getProjects, getPhotos, getBooks, getWeeks, weekText } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;

const posts = (await getPosts(lang)).slice(0, 4);
const allProjects = await getProjects(lang);
const projects = (allProjects.some((p) => p.data.featured) ? allProjects.filter((p) => p.data.featured) : allProjects).slice(0, 3);
const photos = (await getPhotos()).slice(0, 3);
const reading = (await getBooks()).filter((b) => b.data.status === 'current').slice(0, 3);
const latest = (await getWeeks())[0];

// The margin shows the week of the latest week-log entry, so it says
// honestly how fresh the headline is.
const { week, year } = isoWeek(latest?.data.date ?? new Date());
---

<Base lang={lang}>
  <section class="row hero" aria-labelledby="this-week">
    <div class="margin">
      <span class="margin-title">{t(lang, 'home.week')} {week}</span>
      <span class="num">{year}</span>
      <div class="grid-wrap"><WeeksGrid lang={lang} /></div>
    </div>
    <div class="column">
      <h1 id="this-week" class="this-week">
        <span class="visually-hidden">{t(lang, 'home.week')} {week}. </span>
        {latest ? weekText(latest, lang) : t(lang, 'home.intro')}
      </h1>
      {latest && <p class="intro">{t(lang, 'home.intro')} <a href={url(lang, 'weeks')}>{t(lang, 'home.earlier')}</a>.</p>}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="h-writing">
      <EntryList
        lang={lang}
        heading={{ id: 'h-writing', label: t(lang, 'home.latest'), href: url(lang, 'writing') }}
        collection="posts"
        showSummary
        items={posts.map((p) => ({ id: p.id, href: url(lang, 'writing', p.id), title: p.data.title, date: p.data.date, summary: p.data.summary }))}
      />
    </section>
  )}

  {projects.length > 0 && (
    <section class="section" aria-labelledby="h-projects">
      <EntryList
        lang={lang}
        heading={{ id: 'h-projects', label: t(lang, 'home.projects'), href: url(lang, 'projects') }}
        collection="projects"
        showSummary
        items={projects.map((p) => ({ id: p.id, href: url(lang, 'projects', p.id), title: p.data.title, year: p.data.year, summary: p.data.summary }))}
      />
    </section>
  )}

  {reading.length > 0 && (
    <section class="row section" aria-labelledby="h-reading">
      <div class="margin"><a id="h-reading" class="margin-title" href={url(lang, 'bookshelf')}>{t(lang, 'home.reading')}</a></div>
      <ul class="column reading">
        {reading.map((b) => <li><cite>{b.data.title}</cite> <span class="muted">{lang === 'da' ? 'af' : 'by'} {b.data.creator}</span></li>)}
      </ul>
    </section>
  )}

  {photos.length > 0 && (
    <section class="row section" aria-labelledby="h-photos">
      <div class="margin"><a id="h-photos" class="margin-title" href={url(lang, 'photos')}>{t(lang, 'home.photos')}</a></div>
      <div class="column strip">
        {photos.map((p) => (
          <a href={url(lang, 'photos') + '#' + p.id}>
            <Image src={p.data.image} alt={(lang === 'da' ? p.data.captionDa : p.data.captionEn) ?? p.data.title} widths={[360, 720]} sizes="(max-width: 52rem) 100vw, 14rem" />
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero { padding-top: clamp(0.5rem, 3vw, 2rem); }
  .hero { padding-block: clamp(1.5rem, 5vw, 4rem) 0; }
  .hero > .margin { padding-top: 0.75rem; }
  .grid-wrap { margin-top: 1.25rem; }
  .this-week {
    font-size: clamp(2rem, 1.25rem + 2.5vw, 3.2rem); font-weight: 800; line-height: 1.06;
    max-width: 20ch;
  }
  @media (max-width: 52rem) {
    .hero > .margin { grid-auto-flow: row !important; margin-bottom: 1.5rem; }
    .hero > .margin > .num { display: none; }
    .grid-wrap { margin-top: 0.6rem; }
  }
  .intro { margin-top: 1.75rem; color: var(--muted); max-width: 36rem; font-size: 1.125rem; }
  .intro a { color: var(--ink); }


  .reading { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  cite { font-style: italic; }

  .strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
  .strip img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; background: var(--paper-deep); }
  .strip a:hover img { outline: 3px solid var(--pine); outline-offset: -3px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
