---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import Empty from '~/components/Empty.astro';
import { t, langPaths, formatDate, weekLabel, type Lang } from '~/i18n';
import { getPhotos } from '~/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const photos = await getPhotos();
---

<Base lang={lang} title={t(lang, 'photos.title')} current="photos">
  <PageHead title={t(lang, 'photos.title')} intro={t(lang, 'photos.intro')} />
  {photos.length === 0 && <Empty text={t(lang, 'empty.photos')} />}
  <div class="diary">
    {photos.map((p) => {
      const caption = lang === 'da' ? p.data.captionDa : p.data.captionEn;
      return (
        <figure class="row" id={p.id}>
          <div class="margin">
            <span class="margin-title">{weekLabel(lang, p.data.date)}</span>
            {p.data.place && <span class="muted place">{p.data.place}</span>}
            <time class="num" datetime={p.data.date.toISOString()}>{formatDate(lang, p.data.date, 'short')}</time>
          </div>
          <div class="column">
            <Image src={p.data.image} alt={caption ?? p.data.title} widths={[480, 960, 1440]} sizes="(max-width: 52rem) 100vw, 42rem" />
            {caption && <figcaption>{caption}</figcaption>}
          </div>
        </figure>
      );
    })}
  </div>
</Base>

<style>
  .diary { display: grid; gap: var(--block); }
  figure { margin: 0; scroll-margin-top: 2rem; }
  .column { display: grid; gap: 0.75rem; }
  img { width: 100%; background: var(--paper-deep); }
  figcaption { font-size: 0.95rem; }
  .place { font-size: 0.95rem; }
</style>
